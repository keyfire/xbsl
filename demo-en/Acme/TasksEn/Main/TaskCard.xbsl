method SaveAndClose(Command: UsualCommand)
    WriteAndClose.Execute()
;

method MarkDone(Source: Button, Event: OnClickEvent)
    var PreviousTitle = Object.Name   
    // Mark the task done — writing is all that is left…
    var StepCount: Number2 = Object.Steps.Size()
    Object.Importance = StepCount
    Object.Done = True
    Write.Execute()
;
