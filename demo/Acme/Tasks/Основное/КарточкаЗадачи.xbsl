метод ЗаписатьИЗакрыть(Команда: ОбычнаяКоманда)
    ЗаписатьИЗакрыть.Выполнить()
;

метод ОтметитьВыполненной(Источник: Кнопка, Событие: СобытиеПриНажатии)
    пер ПрежнееНазвание = Объект.Наименование   
    // Помечаем задачу выполненной — останется только записать…
    пер ЧислоШагов: Число2 = Объект.Шаги.Размер()
    Объект.Важность = ЧислоШагов
    Объект.Выполнена = Истина
    Записать.Выполнить()
;
