{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XBSL",
  "scopeName": "source.xbsl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#decorators" },
    { "include": "#function-declaration" },
    { "include": "#keywords-control" },
    { "include": "#storage" },
    { "include": "#modifiers" },
    { "include": "#operator-words" },
    { "include": "#constants" },
    { "include": "#language-variables" },
    { "include": "#generic-type" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.xbsl",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.xbsl",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.xbsl",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.xbsl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.xbsl",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.braced.xbsl",
          "match": "(?<!\\\\)[%$]\\{[^}]*\\}",
          "captures": {
            "0": { "name": "variable.other.interpolation.xbsl" }
          }
        },
        {
          "name": "variable.other.interpolation.xbsl",
          "match": "(?<!\\\\)[%$][A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.xbsl",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "decorators": {
      "name": "storage.type.annotation.xbsl",
      "match": "@[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*"
    },
    "function-declaration": {
      "comment": "The declared name of a method: the keyword keeps its own scope, the name becomes a function name. The rule stands BEFORE #storage - both match at the keyword, and a tie at the same position is broken by the order of the patterns, not by the match length.",
      "match": "(?i)\\b(метод|method|конструктор|constructor)([ \\t]+)([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.xbsl" },
        "3": { "name": "entity.name.function.xbsl" }
      }
    },
    "function-call": {
      "comment": "A called name. The rule stands AFTER the keyword ones, so 'если (', 'выбор (' and the constructor keyword are taken as keywords first; what is left before an opening parenthesis is a method - of this module, of another one, or of the platform.",
      "name": "entity.name.function.xbsl",
      "match": "[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*(?=[ \\t]*\\()"
    },
    "keywords-control": {
      "name": "keyword.control.xbsl",
      "match": "(?i)\\b(если|if|иначе|else|выбор|case|когда|when|умолчание|default|для|for|по|to|из|in|вниз|down|шаг|step|пока|while|попытка|try|поймать|catch|вконце|finally|выбросить|throw|возврат|return|прервать|break|продолжить|continue|импорт|import|исп|use|область|scope)\\b"
    },
    "storage": {
      "name": "storage.type.xbsl",
      "match": "(?i)\\b(метод|method|пер|var|знч|val|обз|req|структура|structure|перечисление|enum|исключение|exception|конст|const|конструктор|constructor|запрос|query|тип|type)\\b"
    },
    "modifiers": {
      "name": "storage.modifier.xbsl",
      "match": "(?i)\\b(статический|static|абстрактный|abstract|глобальный|global|никогда|never|неизвестно|unknown)\\b"
    },
    "operator-words": {
      "name": "keyword.operator.word.xbsl",
      "match": "(?i)\\b(и|and|или|or|не|not|это|is|как|as|новый|new)\\b"
    },
    "constants": {
      "name": "constant.language.xbsl",
      "match": "(?i)\\b(истина|true|ложь|false|неопределено|ничто|undefined)\\b"
    },
    "language-variables": {
      "name": "variable.language.xbsl",
      "match": "(?i)\\b(этот|this)\\b"
    },
    "generic-type": {
      "name": "support.class.xbsl",
      "match": "\\b[A-ZА-ЯЁ][A-Za-zА-Яа-яЁё0-9_]*(?=<)"
    },
    "operators": {
      "name": "keyword.operator.xbsl",
      "match": "!=|\\*\\*|\\*=|\\+=|-=|->|/=|::|<=|==|>=|\\?\\.|\\?\\?|[-+*/%<>=!&|?]"
    }
  }
}
